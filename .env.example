# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# Required: Kimi K3.1 Pro on Cerebras (the model for the main agent and every sub-agent).
CEREBRAS_API_KEY=

# SEC EDGAR asks automated clients to identify themselves: "Your Name you@example.com".
SEC_USER_AGENT=

# Optional: DeepSeek, a cheap alternative provider for testing (plugin/use-model.sh deepseek).
DEEPSEEK_API_KEY=
# Optional: OpenRouter, Kimi K3.1 Pro on GPU hosts, for the GPU-side benchmark (PT_PROVIDER=openrouter).
OPENROUTER_API_KEY=

# Optional data keys. Each feature shows "add NAME to .env" when its key is missing.
# EIA: US oil and gas inventories (eia.gov/opendata).
EIA_API_KEY=
# USDA NASS: crop reports (quickstats.nass.usda.gov/api).
NASS_API_KEY=
# Patents come from Google Patents (no key). PatentsView's API was retired by USPTO in 2026;
# PATENTSVIEW_API_KEY is only used if that API comes back.
PATENTSVIEW_API_KEY=
# OpenDART: Korean filings for Samsung and SK hynix (opendart.fss.or.kr).
DART_API_KEY=
# UN Comtrade: full trade data. The capped public preview works without a key.
COMTRADE_API_KEY=
# FRED API. The CSV downloads work without a key.
FRED_API_KEY=

# Advanced: force a provider (cerebras, deepseek, openrouter), a model name, or Cerebras reasoning effort.
PT_PROVIDER=
PT_MODEL=
PT_EFFORT=

# Absolute path to a Node binary for plugin/oc, if the one on PATH is the wrong version.
POCKET_NODE=
# Port of the OpenClaw Gateway page (default 19789).
POCKET_PORT=
# Colon-separated list of other env files to read keys from (~ allowed). Only fills names not already set.
POCKET_EXTRA_ENV=
